# ============================================
# C++ .gitignore for VS Code + GCC (MinGW)
# ============================================

# ===== Compiled files =====
*.exe
*.out
*.app
*.o
*.obj
*.lo
*.slo

# ===== Libraries =====
*.a
*.lib
*.la
*.lai
*.so
*.so.*
*.dll
*.dylib

# ===== Debug information =====
*.pdb
*.ilk
*.dwo

# ===== Precompiled headers =====
*.gch
*.pch

# ===== Temporary files =====
*.tmp
*.log
*.bak
*.swp
*.swo
*~

# ===== Build directories =====
build/
Build/
build-*/
cmake-build-*/

# ===== CMake =====
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# ===== VS Code =====
.vscode/

# ===== Operating system files =====
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ===== Other =====
.cache/
Testing/